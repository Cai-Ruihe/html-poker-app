# Exact origin that serves the browser app. Include scheme and host, but no path.
NORMAL_APP_ORIGIN=https://YOUR-GITHUB-USERNAME.github.io

# Absolute path on this server. The file contains the operator token; this file does not.
RELAY_OPERATOR_TOKEN_FILE=/absolute/path/to/operator-token

# Loopback port used by the host TLS proxy or temporary tunnel.
POKER_CONNECTION_PORT=8787
